<div class="card">
  <div class="card-header">Recent Visits</div>
  <div class="card-body p-0">
    <% if recent_visits.any? %>
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
          <thead>
            <tr>
              <th>IP Address</th>
              <th>Country</th>
              <th>Visited At</th>
            </tr>
          </thead>
          <tbody>
            <% recent_visits.each do |visit| %>
              <tr>
                <td class="font-monospace"><%= visit.ip_address %></td>
                <td><%= visit.country.presence || "—" %></td>
                <td><%= visit.visited_at&.strftime("%b %d, %Y %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="d-flex justify-content-center pt-3 pb-1">
        <%== pagy.series_nav_js(:bootstrap) %>
      </div>
    <% else %>
      <div class="p-3 text-muted">No visits yet.</div>
    <% end %>
  </div>
</div>
