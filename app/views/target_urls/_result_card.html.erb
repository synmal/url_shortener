<%= render layout: "shared/centered_card" do %>
  <h1 class="h4 mb-3">Your shortened URL</h1>

  <div class="mb-3">
    <label class="form-label text-muted small">Original URL</label>
    <div class="text-break"><%= link_to target_url.url, target_url.url, target: "_blank", rel: "noopener" %></div>
  </div>

  <div class="mb-3">
    <label class="form-label text-muted small">Short URL</label>
    <div class="input-group" data-controller="clipboard">
      <%= text_field_tag :short_url, short_url_url(short_url.slug), readonly: true, class: "form-control font-monospace", id: "short_url_input", data: { clipboard_target: "source" } %>
      <button type="button" class="btn btn-outline-secondary" data-action="clipboard#copy">
        <i class="bi bi-clipboard"></i>
      </button>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center">
    <%= link_to "Shorten another", root_path, data: { turbo_frame: "url_card" }, class: "btn btn-link" %>
    <%= link_to "View metrics", short_url_metrics_path(short_url.slug), data: { turbo_frame: "_top" }, class: "btn btn-outline-secondary btn-sm" %>
  </div>
<% end %>
