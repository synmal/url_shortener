<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Url Shortener" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Url Shortener">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Url Shortener", root_path, class: "navbar-brand mb-0 h1" %>
      </div>
    </nav>

    <main class="container py-4">
      <div id="flash">
        <% flash.each do |flash_type, message| %>
          <% alert_type = { notice: "success", alert: "danger", error: "danger" }.fetch(flash_type.to_sym, "info") %>
          <%= render "shared/flash_notice", message: message, type: alert_type %>
        <% end %>
      </div>

      <%= yield %>
    </main>
  </body>
</html>
