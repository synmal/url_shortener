# Secrets defined here are available for reference under registry/password, env/secret,
# builder/secrets, and accessories/*/env/secret in config/deploy.yml.
# All values are pulled from environment variables — DO NOT ENTER RAW CREDENTIALS.

# GitHub Container Registry authentication
GITHUB_TOKEN=$GITHUB_TOKEN

# Rails credentials decryption
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Database
URL_SHORTENER_DATABASE_PASSWORD=$URL_SHORTENER_DATABASE_PASSWORD
POSTGRES_PASSWORD=$URL_SHORTENER_DATABASE_PASSWORD

# Server
SERVER_HOST=$SERVER_HOST
APP_HOST=$APP_HOST
SSH_USER=$SSH_USER
